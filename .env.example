# --- Obligatorias ---
# Ticket de la API oficial de Mercado Público (https://api.mercadopublico.cl). Nunca lo subas a git.
MERCADOPUBLICO_TICKET=

# Usuario y contraseña de acceso a la app (HTTP Basic). En producción son obligatorios; contraseña de 12+ caracteres.
APP_USER=
APP_PASSWORD=

# --- Opcionales ---
# Clave de Gemini para las evaluaciones IA. Sin ella, la app muestra una estimación por palabras clave marcada "sin IA".
GEMINI_API_KEY=

# Base de datos PostgreSQL (Supabase). Sin ella, los datos se guardan en archivos JSON locales (se pierden al redesplegar en la nube).
DATABASE_URL=
# Certificado CA de Supabase (contenido PEM, con \n) para verificar SSL de la base de datos.
DATABASE_CA_CERT=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Conexión ClaveÚnica / scraping con navegador. Deshabilitada en producción salvo que se ponga "true".
ENABLE_MP_SCRAPER=false

# Puerto (Cloud Run lo define automáticamente).
PORT=3000
